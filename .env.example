# Copy to .env and fill in.

# Neon Postgres connection string (Dashboard -> Connection Details -> Prisma).
# Use the POOLED connection string (host has "-pooler" in it). The extra query
# params raise Prisma's client-side pool size/timeout so a short burst of
# concurrent chat requests doesn't hit "timed out fetching a connection".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&connection_limit=10&pool_timeout=20"

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-key-here"

# Model id (cheap tier). Used for both triage and reply generation.
GEMINI_MODEL="gemini-2.5-flash-lite"

# Secret for signing staff JWTs. Any long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Seed staff login (created by `npm run seed`).
STAFF_EMAIL="staff@edin.world"
STAFF_PASSWORD="welfare123"
STAFF_NAME="Alex Staff"
